# =============================================================================
# Python Backend Environment Configuration
# =============================================================================

# Application environment ('development' for local pairing, 'production' for deployment)
APP_ENV=development

# OpenAI API credentials (required for RAG query generation)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Demonstration Bearer token required for backend access
# In development, leave empty for open local access. In production, this is required.
DEMO_ACCESS_TOKEN=

# Reviewer Access Token for Streamlit interface and Next.js proxy
# Visitors receive 5 free questions per session. Entering this token bypasses
# the demo quota for that session and unlocks unlimited queries.
REVIEWER_ACCESS_TOKEN=

# Contact destination for access requests when the 5-question demo quota is exhausted.
# Configure either CONTACT_URL (e.g., https://example.com/contact) or CONTACT_EMAIL (e.g., author@example.com).
# If neither is configured, a setup notice is displayed without inventing contact details.
CONTACT_EMAIL=
CONTACT_URL=

# Allowed frontend origins (exact matches, comma-separated, no wildcards)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Proxy header trust (false by default to prevent spoofed X-Forwarded-For headers)
TRUST_PROXY_HEADERS=false

# Network binding
HOST=127.0.0.1
PORT=8000

# Storage & Model Cache Paths (for direct deployment or containers)
CHROMA_PERSIST_DIRECTORY=./storage/chroma
DOCUMENTS_DIRECTORY=./data/documents
HF_HOME=./.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=./.cache/huggingface

# Operational Limits
MAX_CONCURRENT_QUERIES=3
RATE_LIMIT_PER_MINUTE=15