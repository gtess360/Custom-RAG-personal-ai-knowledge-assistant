# Git and repository metadata
.git/
.gitignore

# Environment and secrets - NEVER bake credentials into container images
.env
.env.*
!.env.example

# Python virtual environment and bytecode
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node.js and frontend artifacts
node_modules/
frontend/

# Local database storage (mounted at runtime as persistent volume)
storage/chroma/
storage/

# Evaluation and test suites not needed in runtime production container
tests/
evaluation/
docs/

# IDE and OS files
.gemini/
.vscode/
.idea/
.DS_Store
powershell.cmd
